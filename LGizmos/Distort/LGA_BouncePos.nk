Group {
name LGA_BouncePos1
tile_color 0xb15bbbff
selected true
xpos 306
ypos 3361
addUserKnob {20 BouncePos}
addUserKnob {26 source_note l "" -STARTLINE T "<span style=\"color:#979797\">Bounce is calculated from this translate motion.<br/>Animate it here, or link it from a another Transform.</span><br/><span style=\"font-size:4px\">&nbsp;</span>"}
addUserKnob {12 translate l "Source Translate"}
addUserKnob {26 ""}
addUserKnob {7 amount l Amount t "Overall bounce strength. 0 disables the generated offset; negative values invert the bounce direction." R -4 4}
amount 1
addUserKnob {7 x_mult l "X Mult" t "Multiplier for the generated horizontal bounce. 0 removes X bounce; negative values invert only X." R -4 4}
x_mult 1
addUserKnob {7 y_mult l "Y Mult" t "Multiplier for the generated vertical bounce. 0 removes Y bounce; negative values invert only Y." R -4 4}
y_mult 1
addUserKnob {7 lookahead l Lookahead t "Number of frames sampled before and after the current frame. Higher values react to broader motion changes; lower values react to sharper frame-to-frame changes." R 1 15}
lookahead 1
addUserKnob {7 delay l Delay t "Shifts the sampled source motion in time. Positive values make the bounce use earlier motion; negative values make it anticipate later motion." R -10 10}
addUserKnob {7 bounce_length l "Bounce Length" t "Extra bounce tail length in frames. 0 keeps the original one-frame acceleration response; higher values add a longer oscillating release." R 0 15}
addUserKnob {7 bounce_decay l "Bounce Decay" t "How quickly the extra bounce tail fades out. 0 keeps more energy; 1 kills the tail almost immediately."}
bounce_decay 0.25
addUserKnob {7 bounce_frequency l "Bounce Frequency" t "Number of oscillation cycles across the Bounce Length. Lower values feel slower; higher values feel more jittery." R 0 4}
bounce_frequency 1.5
addUserKnob {26 "" +STARTLINE}
addUserKnob {3 start_frame l "Start Frame" t "First valid source-motion frame. Defaults to 1001; set this to your shot start frame."}
start_frame 1001
addUserKnob {6 ignore_start_frame l "Ignore Start Frame" t "Prevents impulses that need frames before Start Frame from feeding the bounce. This avoids false bounce at the beginning of a shot." -STARTLINE}
ignore_start_frame true
addUserKnob {7 impulse_weight l "Impulse Weight" t "Per-frame multiplier for detected motion impulses. Animate to 0 on bad tracking frames so they do not feed the bounce tail."}
impulse_weight 1
addUserKnob {7 max_offset l "Max Offset" t "Maximum generated offset in pixels for each axis. This clamps extreme bounce values so the result cannot jump too far." R 0 500}
max_offset 100
addUserKnob {26 ""}
addUserKnob {41 bounce_offset l "Bounce Offset" t "Calculated bounce offset in pixels, based on Source Translate and the current bounce controls." T Bounce_Output.bounce_offset}
addUserKnob {26 ""}
addUserKnob {41 filter T Bounce_Transform.filter}
addUserKnob {41 motionblur T Bounce_Transform.motionblur}
addUserKnob {41 shutter T Bounce_Transform.shutter}
addUserKnob {26 about l "" +STARTLINE T "<span style=\"color:#666\"><br/><b>LGA_BouncePos v0.5</b> - position bounce from source translate acceleration.</span>"}
}
Input {
inputs 0
name Input1
xpos 0
}
