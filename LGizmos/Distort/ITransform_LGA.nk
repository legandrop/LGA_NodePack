Group {
 name ITransform_LGA
 tile_color 0xa57aaaff
 selected true
 addUserKnob {20 "" l Transform}
 addUserKnob {41 channels T STMap.channels}
 addUserKnob {6 blackOutside_1 l "Black Outside Before?" +STARTLINE}
 addUserKnob {41 translate T Transform1.translate}
 addUserKnob {41 rotate T Transform1.rotate}
 addUserKnob {41 scale T Transform1.scale}
 addUserKnob {41 skewX l "skew X" T Transform1.skewX}
 addUserKnob {41 skewY l "skew Y" T Transform1.skewY}
 addUserKnob {41 skew_order l "skew order" T Transform1.skew_order}
 addUserKnob {41 center T Transform1.center}
 addUserKnob {22 setCenter l "Set Center" -STARTLINE T "n = nuke.thisGroup()\nw= n.width()\nh=n.height()\nn\['center'].setValue(\[w/2,h/2])"}
 addUserKnob {41 filter_1 l filter T MapTransform.filter}
 addUserKnob {41 clamp -STARTLINE T MapTransform.clamp}
 addUserKnob {41 motionblur T Transform1.motionblur}
 addUserKnob {41 shutter T Transform1.shutter}
 addUserKnob {41 shutteroffset l "shutter offset" T Transform1.shutteroffset}
 addUserKnob {41 offset l "" -STARTLINE T Transform1.shuttercustomoffset}
 addUserKnob {26 ""}
 addUserKnob {6 cropToFormat l "Crop To Format" +STARTLINE}
 addUserKnob {6 blackOutside2 l "Black Outside After" -STARTLINE}
 addUserKnob {14 addPixels l "Add Pixels" R 0 100}
 addUserKnob {7 mix}
 mix 1
}
 Input {
  inputs 0
  name ctrlMask
  xpos 606
  ypos 531
  number 1
 }
set NmaskInput [stack 0]
 NoOp {
  name MaskBBox
  xpos 606
  ypos 555
  addUserKnob {20 User}
  addUserKnob {15 bbox}
  bbox {{input.bbox.x} {input.bbox.y} {input.bbox.r} {input.bbox.t}}
 }
 Expression {
  temp_name0 alpha_mask
  temp_expr0 a
  expr0 alpha_mask
  expr1 alpha_mask
  expr2 alpha_mask
  expr3 alpha_mask
  name Mask
  xpos 606
  ypos 579
 }
set Nmask [stack 0]
 Input {
  inputs 0
  name img
  xpos 121
  ypos 344
 }
 BlackOutside {
  name BlackOutside1
  xpos 121
  ypos 370
  disable {{!parent.blackOutside_1}}
 }
set Nimg [stack 0]
 Crop {
  box {{-input.format.width} {-input.format.height} {input.format.width*2} {input.format.height*2}}
  crop false
  name CropOverscan
  xpos 474
  ypos 370
  addUserKnob {20 User}
  addUserKnob {22 cropToBbox l "Crop to Bounding Box" -STARTLINE T codeBBox()}
 }
 Expression {
  expr0 (x+0.5)/width
  expr1 (y+0.5)/height
  name UV
  xpos 474
  ypos 418
 }
set Nuv [stack 0]
 Dot {
  name DotUV
  xpos 343
  ypos 421
 }
push $Nmask
push $Nuv
 Transform {
  translate {{parent.Transform1.translate} {parent.Transform1.translate}}
  rotate {{parent.Transform1.rotate}}
  scale {{parent.Transform1.scale} {parent.Transform1.scale}}
  skewX {{parent.Transform1.skewX}}
  skewY {{parent.Transform1.skewY}}
  skew_order {{parent.Transform1.skew_order}}
  center {{parent.Transform1.center} {parent.Transform1.center}}
  motionblur {{parent.Transform1.motionblur}}
  shutter {{parent.Transform1.shutter}}
  shutteroffset {{parent.Transform1.shutteroffset}}
  shuttercustomoffset {{parent.Transform1.shuttercustomoffset}}
  name MapTransform
  xpos 599
  ypos 418
 }
push $Nuv
 Keymix {
  inputs 3
  name MaskMix
  xpos 474
  ypos 525
 }
 Expression {
  expr0 ((x+0.5)/width)
  expr1 ((y+0.5)/height)
  mix {{1-parent.mix}}
  name MixUV
  xpos 309
  ypos 563
 }
push $Nimg
 NoOp {
  name InputBBox
  xpos 126
  ypos 723
  addUserKnob {20 User}
  addUserKnob {15 bbox}
  bbox {{input.bbox.x} {input.bbox.y} {input.bbox.r} {input.bbox.t}}
 }
 STMap {
  inputs 2
  channels rgba
  uv rgb
  name STMap
  xpos 309
  ypos 723
 }
 Crop {
  box {{"InputBBox.bbox<MaskBBox.bbox?InputBBox.bbox-addPixels:InputBBox.bbox+(MaskBBox.bbox-InputBBox.bbox)-addPixels"} {"InputBBox.bbox<MaskBBox.bbox?InputBBox.bbox-addPixels:InputBBox.bbox+(MaskBBox.bbox-InputBBox.bbox)-addPixels"} {"InputBBox.bbox>MaskBBox.bbox?InputBBox.bbox+addPixels:InputBBox.bbox+(MaskBBox.bbox-InputBBox.bbox)+addPixels"} {"InputBBox.bbox>MaskBBox.bbox?InputBBox.bbox+addPixels:InputBBox.bbox+(MaskBBox.bbox-InputBBox.bbox)+addPixels"}}
  name Crop1
  xpos 309
  ypos 747
  addUserKnob {20 User}
  addUserKnob {22 cropToBbox l "Crop to Bounding Box" -STARTLINE T codeBBox()}
 }
 Reformat {
  name Reformat1
  xpos 309
  ypos 771
  disable {{!parent.cropToFormat}}
 }
 BlackOutside {
  name BlackOutside2
  xpos 309
  ypos 797
  disable {{!parent.blackOutside2}}
 }
 Output {
  name Output1
  xpos 309
  ypos 823
 }
 Transform {
  inputs 0
  center {1220 901}
  black_outside false
  name Transform1
  xpos 715
  ypos 417
 }
end_group
