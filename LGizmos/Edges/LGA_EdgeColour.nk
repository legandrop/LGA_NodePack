set cut_paste_input [stack 0]
version 17.0 v4
push $cut_paste_input
Group {
 name LGA_EdgeColour1
 tile_color 0x7a9cc6ff
 selected true
 addUserKnob {20 edge_colour_tab l "Edge Colour"}
 addUserKnob {26 info l "" +STARTLINE T "Clean foreground colour in the soft edge: the solid inside colour pushed outwards,\nwith Blur-Fusion luminance kept in the local range. The alpha is not changed.\nSource: plate rgb.  Matte: alpha (if empty, Source alpha is used)."}
 addUserKnob {4 view t "Que muestra la salida: el resultado, el peso del reemplazo (blanco = color reconstruido) o el color del interior empujado hacia afuera." M {result "edge weight" "extended colour"}}
 addUserKnob {26 inner_divider l inside}
 addUserKnob {7 erode t "Cuantos pixeles se achica el interior solido antes de usarlo como fuente de color. Valor habitual en UHD: 4." R 0 20}
 erode 4
 addUserKnob {7 inner_low l "inner softness" t "Rango del alpha donde el interior pasa de banda (abajo) a solido (arriba), con curva suave. Valores habituales: 0.90 y 0.99." R 0.5 1}
 inner_low 0.9
 addUserKnob {7 inner_high l "" t "Rango del alpha donde el interior pasa de banda (abajo) a solido (arriba), con curva suave. Valores habituales: 0.90 y 0.99." -STARTLINE R 0.5 1}
 inner_high 0.99
 addUserKnob {7 inner_blur l "inner blur" t "Suavizado en pixeles del borde del interior: evita un corte duro entre el PLATE y el color reconstruido. Valor habitual: 4." R 0 30}
 inner_blur 4
 addUserKnob {26 edge_divider l edge}
 addUserKnob {7 near t "Distancia en pixeles al fondo real (alpha casi 0) hasta donde el color se reemplaza entero. Valor habitual en UHD: 48." R 0 400}
 near 48
 addUserKnob {7 far t "Distancia en pixeles al fondo real donde el reemplazo ya se apago y vuelve el PLATE. Entre near y far hay una rampa suave. Valor habitual en UHD: 80." R 0 600}
 far 80
 addUserKnob {7 spread t "Multiplica las escalas con que el color del interior se empuja hacia afuera. 1 = escalas de un plano UHD; 0.5 para HD." R 0.25 4}
 spread 1
 addUserKnob {7 luma_range l "luma range" t "Cuantos desvios de la luminancia del interior puede alejarse la luminancia del borde. Mas alto deja pasar mas brillo del borde original (y del fondo). Valor habitual: 1.5." R 0 5}
 luma_range 1.5
 addUserKnob {6 temporal l "temporal smoothing" t "Promedia el color del borde con los dos cuadros de antes y los dos de despues, alineados con vectores de movimiento, para que no tiemble. Usa VectorGenerator (de NukeX en algunas licencias), corre en CPU y es unas seis veces mas lento." +STARTLINE}
 addUserKnob {6 premultiply t "Prendido: la salida sale premultiplicada por el matte. Apagado: sale el color sin premultiplicar, con el matte en el alpha." +STARTLINE}
 premultiply true
 addUserKnob {26 advanced_divider l advanced}
 addUserKnob {7 bg_threshold l "background below" t "Alpha por debajo del cual un pixel cuenta como fondo real para medir near y far." R 0 0.5}
 bg_threshold 0.05
 addUserKnob {7 match_tolerance l "temporal tolerance" t "Cuanto puede diferir el PLATE alineado de un cuadro vecino (en gris ACEScct) para que ese cuadro cuente en el promedio temporal. Mas bajo descarta antes los cuadros mal alineados." R 0.001 0.2}
 match_tolerance 0.03137254902
 addUserKnob {7 large_size l "blur-fusion large" t "Caja grande de Blur-Fusion, de donde sale la luminancia del borde. Valor habitual: 90." R 1 400}
 large_size 90
 addUserKnob {7 small_size l "blur-fusion small" t "Caja chica de Blur-Fusion. Valor habitual: 6." R 1 50}
 small_size 6
 addUserKnob {6 clamp_negative l "clamp negatives" t "Lleva a cero los negativos de Blur-Fusion." +STARTLINE}
 clamp_negative true
 addUserKnob {7 epsilon t "Valor chico que se suma a los divisores." R 0 0.001}
 epsilon 1e-05
}
 Input {
  inputs 0
  name Matte
  xpos 300
  ypos -400
  number 1
 }
 Input {
  inputs 0
  name Source
  xpos 0
  ypos -400
 }
set Na1210000 [stack 0]
 Switch {
  inputs 2
  which {{"\[exists parent.input1]"}}
  name matte_or_source
  xpos 300
  ypos -340
 }
push $Na1210000
 Copy {
  inputs 2
  from0 rgba.alpha
  to0 rgba.alpha
  name copy_alpha
  xpos 0
  ypos -340
 }
 Expression {
  expr0 r
  expr1 g
  expr2 b
  expr3 "clamp(a, 0, 1)"
  name image_and_matte
  xpos 0
  ypos -300
 }
 Crop {
  box {{0} {0} {width} {height}}
  name crop_image
  xpos 0
  ypos -260
 }
