set cut_paste_input [stack 0]
version 15.1 v6
Group {
 name LGA_ContactSheet
 selected true
 xpos 0
 ypos 0
 onCreate "import importlib\nimport LGA_ContactSheet_tools as m\nimportlib.reload(m)\nm.on_create()"
 knobChanged "import importlib\nimport LGA_ContactSheet_tools as m\nimportlib.reload(m)\nm.knob_changed()"
 addUserKnob {20 Settings}
 addUserKnob {7 resMult l "Resolution Multiplier" R 0.1 2}
 resMult 1
 addUserKnob {6 filename_burnin l "Filename Burn-in" +STARTLINE}
 filename_burnin true
 addUserKnob {6 vertical_two_inputs l "Vertical Layout for 2 Inputs" +STARTLINE}
 vertical_two_inputs true
 addUserKnob {18 text_color l "Text Color"}
 text_color {1 1 1}
 addUserKnob {7 text_font_size l "Text Scale" R 0.05 5}
 text_font_size 0.505
 addUserKnob {7 text_offset_x l "Text Offset X" R -5000 5000}
 addUserKnob {7 text_offset_y l "Text Offset Y" R -5000 5000}
}
 Input {
  inputs 0
  name Input1
  label 1
  number 0
  xpos 0
  ypos 0
 }
 Text2 {
  message "\[file tail \[value \[topnode parent.input0].file]]\n"
  box {{131.0625+parent.text_offset_x} {85.6875+parent.text_offset_y} {1820.9375+parent.text_offset_x} {158.3125+parent.text_offset_y}}
  global_font_scale {{parent.text_font_size}}
  font_size 154
  autofit_bbox false
  color {{parent.text_color.r} {parent.text_color.g} {parent.text_color.b} 0}
  disable {{1-parent.filename_burnin}}
  name Burnin_0
  xpos 0
  ypos 130
 }
 ContactSheet {
  inputs 1
  width {{input.width*columns*parent.resMult}}
  height {{input.height*rows*parent.resMult}}
  rows {{"\[value parent.vertical_two_inputs] && \[numvalue inputs] == 2 ? 2 : \[expr \{int( (sqrt( \[numvalue inputs] ) ) )\} ] * \[expr \{int( ceil ( (\[numvalue inputs] /(sqrt( \[numvalue inputs] ) ) )) )\} ] < \[numvalue inputs]   ? \[expr \{int( (sqrt( \[numvalue inputs] ) ) )\} ] +1 : \[expr \{int( (sqrt( \[numvalue inputs] ) ) )\} ]"}}
  columns {{"\[value parent.vertical_two_inputs] && \[numvalue inputs] == 2 ? 1 : \[expr \{int( ceil ( (\[numvalue inputs] /(sqrt( \[numvalue inputs] )) )) )\} ]"}}
  center true
  roworder TopBottom
  name ContactSheet1
  xpos 0
  ypos 260
 }
 Output {
  name Output1
  xpos 0
  ypos 360
 }
end_group
