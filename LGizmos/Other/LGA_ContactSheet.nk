set cut_paste_input [stack 0]
version 15.1 v6
Group {
 name LGA_ContactSheet
 selected true
 xpos 0
 ypos 0
 onCreate "import importlib\nimport LGA_ContactSheet_tools as m\nimportlib.reload(m)\nm.on_create()"
 knobChanged "import importlib\nimport LGA_ContactSheet_tools as m\nimportlib.reload(m)\nm.knob_changed()"
 addUserKnob {20 Settings}
 addUserKnob {7 resMult l "Resolution Multiplier" R 0.1 2}
 resMult 1
 addUserKnob {6 filename_burnin l "Filename Burn-in" +STARTLINE}
}
 Input {
  inputs 0
  name Input1
  label 1
  number 0
  xpos 0
  ypos 0
 }
 Text2 {
  message "\[file tail \[knob \[topnode].file]]\n"
  box {131.0625 85.6875 1820.9375 158.3125}
  global_font_scale 0.505
  font_size 154
  autofit_bbox false
  color {0 1 0 0}
  disable {{1-parent.filename_burnin}}
  name Burnin_0
  xpos 0
  ypos 130
 }
 ContactSheet {
  inputs 1
  width {{input.width*columns*parent.resMult}}
  height {{input.height*rows*parent.resMult}}
  rows {{"\[expr \{int( (sqrt( \[numvalue inputs] ) ) )\} ] * \[expr \{int( ceil ( (\[numvalue inputs] /(sqrt( \[numvalue inputs] ) ) )) )\} ] < \[numvalue inputs]   ? \[expr \{int( (sqrt( \[numvalue inputs] ) ) )\} ] +1 : \[expr \{int( (sqrt( \[numvalue inputs] ) ) )\} ]"}}
  columns {{"\[expr \{int( ceil ( (\[numvalue inputs] /(sqrt( \[numvalue inputs] )) )) )\} ]"}}
  center true
  roworder TopBottom
  name ContactSheet1
  xpos 0
  ypos 260
 }
 Output {
  name Output1
  xpos 0
  ypos 360
 }
end_group
