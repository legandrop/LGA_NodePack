set cut_paste_input [stack 0]
version 17.0 v4
push $cut_paste_input
Group {
 name LGA_LightFromPlate1
 tile_color 0xd9a441ff
 selected true
 addUserKnob {20 LightFromPlate}
 addUserKnob {26 div_light l "" +STARTLINE T "<b>Light from Plate</b>"}
 addUserKnob {7 amount l Amount t "Cantidad de Light from Plate. 1 = la luz de baja frecuencia del Plate con el detalle del render (arrugas). 0 = dentro de la piel vuelve el detalle del Plate. Mas de 1 exagera el detalle del render. Valor habitual: 1.0." R 0 2}
 amount 1
 addUserKnob {7 cutoff l "Cutoff (% head width)" t "Corte entre luz y detalle, en % del ancho de cabeza (se acota entre 0.25 y 16). sigma = Head width x Cutoff / 100. Valor habitual: 2.0." R 0.25 16}
 cutoff 2
 addUserKnob {7 head_width l "Head width (px)" t "Ancho de la cabeza en pixeles, medido por cuadro sobre un matte de cabeza (primera a ultima columna con matte mayor que 0.5). Se puede escribir, animar o medir con el boton." R 0 4000}
 head_width 1000
 addUserKnob {7 sigma l "Sigma (px)" t "Sigma en pixeles que resulta de Head width y Cutoff (solo lectura)." +DISABLED R 0 200}
 sigma {{"max(1, head_width * clamp(cutoff, 0.25, 16) / 100)"}}
 addUserKnob {4 measure_from l "Measure from" t "De que entrada sale el matte de cabeza que se mide: matte, skin o area. Usa el mismo canal elegido para esa entrada." M {matte skin area}}
 addUserKnob {3 measure_first l Range t "Primer y ultimo cuadro a medir."}
 measure_first {{root.first_frame}}
 addUserKnob {3 measure_last l "" t "Primer y ultimo cuadro a medir." -STARTLINE}
 measure_last {{root.last_frame}}
 addUserKnob {22 measure l "Measure head width" t "Mide el ancho del matte elegido (umbral 0.5) en cada cuadro del rango y lo deja animado en Head width. El resultado queda escrito al lado del boton. Si el matte esta vacio en todo el rango (por ejemplo, el canal elegido no tiene datos) no cambia Head width y lo avisa ahi mismo." T "def _lga_lfp_medir():\n    # El CurveTool se crea solo mientras dura la medicion: uno permanente dentro del grupo imprime un aviso de Nuke\n    # (Setting knob values from validate) cada vez que algo lo valida.\n    n = nuke.thisNode()\n    st = n.knob('measure_status')\n    first, last = int(n.knob('measure_first').value()), int(n.knob('measure_last').value())\n    if last < first:\n        first, last = last, first\n    i = int(n.knob('measure_from').getValue())\n    src = ('matte', 'skin', 'area')\[i]\n    if n.input((4, 2, 3)\[i]) is None:\n        st.setValue('not measured: the %s input is not connected' % src)\n    else:\n        anchos = None\n        with n:\n            mb = nuke.toNode('Measure_bin')\n            ct = nuke.nodes.CurveTool(name='HeadMeasure_tmp', inputs=(mb,))\n        try:\n            ct.knob('operation').setValue('Auto Crop')\n            ct.knob('ROI').setValue((0, 0, mb.width(), mb.height()))\n            nuke.execute(ct, first, last, 1)\n            d = ct.knob('autocropdata')\n            anchos, vacios = \[], 0\n            for f in range(first, last + 1):\n                w = d.getValueAt(f, 2) - d.getValueAt(f, 0) - 1\n                vacio = d.getValueAt(f, 3) - d.getValueAt(f, 1) <= 0 or w < 0\n                vacios += vacio\n                anchos.append(0 if vacio else w)\n        except Exception as e:\n            st.setValue('not measured: %s' % e)\n        finally:\n            nuke.delete(ct)\n        if anchos is not None and vacios == len(anchos):\n            st.setValue('not measured: the %s input is empty in frames %d-%d (nothing above 0.5 in the chosen channel); Head width was not changed' % (src, first, last))\n        elif anchos is not None:\n            k = n.knob('head_width')\n            k.clearAnimated()\n            k.setAnimated()\n            for f, w in zip(range(first, last + 1), anchos):\n                k.setValueAt(w, f)\n            msg = 'measured frames %d-%d from the %s input' % (first, last, src)\n            if vacios:\n                msg += ' (%d frames with an empty matte set to 0)' % vacios\n            st.setValue(msg)\n_lga_lfp_medir()\ndel _lga_lfp_medir\n" +STARTLINE}
 addUserKnob {26 measure_status l "" +STARTLINE T " "}
 addUserKnob {26 line_masks l "" +STARTLINE}
 addUserKnob {26 div_masks l "" +STARTLINE T "<b>Masks (optional)</b>"}
 addUserKnob {4 skin_from l "Skin mask from" t "De donde sale la mascara opcional que limita el efecto (se binariza en 0.5): el alfa o el rojo de la entrada skin, o el alfa del render. Un PNG gris entra por red: si se elige alpha y la entrada no tiene canal alfa, se usa red. Con render alpha y un render sin alfa no hay mascara. Con alpha o red y la entrada skin sin conectar tampoco: la luz se mide y se aplica en todo el cuadro." M {alpha red "render alpha"}}
 addUserKnob {4 area_from l "Area mask from" t "Canal de la entrada area, opcional: zona donde se aplica el resultado (se binariza en 0.5 y se une con la mascara skin). Sin conectar, la zona es la misma mascara skin. Un PNG gris entra por red: si se elige alpha y la entrada no tiene canal alfa, se usa red." M {alpha red}}
 addUserKnob {3 area_grow l "Area grow (px)" t "Cuanto se agranda la zona de aplicacion antes de suavizarla, en pixeles (disco). Valor habitual: 6."}
 area_grow 6
 addUserKnob {7 area_soften l "Area soften (px)" t "Sigma del borde suave de la zona de aplicacion, en pixeles. Valor habitual: 8." R 0 50}
 area_soften 8
 addUserKnob {26 line_color l "" +STARTLINE}
 addUserKnob {26 div_color l "" +STARTLINE T <b>Colorspace</b>}
 addUserKnob {6 raw l "Inputs are raw file values" t "Marcar si las entradas traen los valores del archivo sin convertir (Read en raw). Desmarcado, el nodo pasa del espacio de trabajo a Files colorspace, hace la cuenta y vuelve." +STARTLINE}
 addUserKnob {41 colorspace l "Files colorspace" t "Colorspace con el que se leyeron el render y el Plate (tiene que ser el mismo en los dos Read). La cuenta se hace sobre los valores del archivo, tomados como sRGB. Al crear el nodo (o abrir el script), si el colorspace guardado no existe en el config OCIO activo, se elige el rol color_picking (sRGB en los configs que trae Nuke)." T ToFile_render.out_colorspace}
 addUserKnob {26 line_comp l "" +STARTLINE}
 addUserKnob {26 div_comp l "" +STARTLINE T "<b>Over Plate</b>"}
 addUserKnob {6 over_plate l "Composite over Plate" t "Compone el render con la luz del Plate encima del Plate usando el matte elegido. La mezcla se hace siempre en luz lineal (con raw, sobre los valores del archivo pasados a lineal). Desmarcado sale el render completo con la luz corregida." +STARTLINE}
 addUserKnob {4 matte_from l Matte t "Matte de la composicion sobre el Plate: el alfa del render o la entrada matte (por alfa o por red). Si la entrada matte no tiene canal alfa se usa red; si el render no tiene alfa, el render entero va sobre el Plate." M {"render alpha" "matte input alpha" "matte input red"}}
 addUserKnob {7 mix l Mix t "Opacidad del render sobre el Plate (multiplica al matte). Solo actua con Composite over Plate."}
 mix 1
 addUserKnob {26 div_view l "" +STARTLINE}
 addUserKnob {4 view l View t "Que muestra la salida: el resultado, la zona de aplicacion (mascara suave) o la ganancia de luz que se le aplica al render (1 = sin cambio)." M {result "area mask" "light gain"}}
}
 Constant {
  inputs 0
  name MLit_ky_base
 }
 Reformat {
  type "to box"
  box_width {{1}}
  box_height {{2*floor(rint(8*(8)+1)/2)+1}}
  box_fixed true
  resize none
  name MLit_ky_tam
 }
 Expression {
  expr3 "(8)<=0 ? 1 : exp(-pow2(y-floor(rint(8*(8)+1)/2))/(2*pow2(8)))"
  name MLit_ky
 }
 Constant {
  inputs 0
  name MLit_kx_base
 }
