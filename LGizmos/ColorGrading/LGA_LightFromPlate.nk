push $Nec925200
push $Nf62fd600
 OCIOColorSpace {
  in_colorspace scene_linear
  out_colorspace "Output - Rec.709"
  name ToFile_render
  onCreate "def _lga_lfp_colorspace():\n    # Si el colorspace guardado no existe en el config OCIO activo, se elige uno que si exista.\n    t = nuke.thisNode()\n    k = t.knob('out_colorspace')\n    ok = set()\n    for v in t.knob('in_colorspace').values():\n        p = v.split(chr(9))\n        ok.add(p.pop(0))\n        if len(p) > 2:\n            ok.update(a.strip() for a in p.pop().split(','))\n    if k.value() not in ok:\n        for c in ('color_picking', 'sRGB Encoded Rec.709 (sRGB)', 'sRGB', 'Utility - sRGB - Texture'):\n            if c in ok:\n                k.setValue(c)\n                break\n_lga_lfp_colorspace()\ndel _lga_lfp_colorspace\n"
  disable {{parent.raw}}
 }
 Expression {
  expr0 "r<=0.04045 ? r/12.92 : pow((r+0.055)/1.055, 2.4)"
